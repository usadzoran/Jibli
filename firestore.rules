rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function userProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && userProfile().role == 'admin'; }
    function isDriver() { return isSignedIn() && userProfile().role == 'driver' && userProfile().status == 'active'; }
    function isCustomer() { return isSignedIn() && userProfile().role == 'customer'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------
    // DEFAULT DENY
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'status']) &&
             data.id == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['customer', 'driver', 'admin'] &&
             data.status in ['active', 'pending', 'rejected', 'suspended'] &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || (isDriver() && exists(/databases/$(database)/documents/orders/$(request.auth.uid)))); // Slightly complex, driver can see customer only if assigned
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && incoming().role != 'admin'; 
      allow update: if (isOwner(userId) && incoming().status == existing().status && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatar_url', 'address'])) || isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // PRODUCTS
    // ---------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category_id', 'stock']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category_id is string &&
             data.stock is int && data.stock >= 0;
    }

    match /products/{productId} {
      allow read: if true; 
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    // ---------------------------------------------------------
    // CATEGORIES
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // ORDERS
    // ---------------------------------------------------------
    function isValidOrder(data) {
      return data.keys().hasAll(['customer_id', 'status', 'total', 'delivery_address']) &&
             data.customer_id == request.auth.uid &&
             data.status in ['pending', 'accepted', 'picked_up', 'delivered', 'cancelled'] &&
             data.total is number && data.total >= 0 &&
             data.delivery_address is string && data.delivery_address.size() > 0;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().customer_id) || (isDriver() && (existing().status == 'pending' || existing().driver_id == request.auth.uid)) || isAdmin());
      allow list: if isSignedIn() && (
        (isOwner(resource.data.customer_id)) ||
        (isDriver() && (resource.data.status == 'pending' || resource.data.driver_id == request.auth.uid)) ||
        (isAdmin())
      );
      allow create: if isCustomer() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Customer canceling
        (isOwner(existing().customer_id) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
         incoming().status == 'cancelled' && 
         existing().status == 'pending') ||
        
        // Driver accepting - only if active
        (isDriver() && existing().status == 'pending' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driver_id']) && 
         incoming().status == 'accepted' && 
         incoming().driver_id == request.auth.uid) ||
        
        // Driver updating status
        (isDriver() && existing().driver_id == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
         (
           (existing().status == 'accepted' && incoming().status == 'picked_up') ||
           (existing().status == 'picked_up' && incoming().status == 'delivered')
         )) ||
        
        isAdmin()
      );
    }

    match /orders/{orderId}/items/{itemId} {
      allow read: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.customer_id) || isDriver() || isAdmin());
      allow create: if isSignedIn() && isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.customer_id);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // REVIEWS
    // ---------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && 
                    isOwner(incoming().customer_id) &&
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.status == 'delivered';
      allow update, delete: if false;
    }
  }
}
